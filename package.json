{
  "name": "daniilivanovdev",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "workspaces": ["apps/api", "apps/web"],
  "engines": {
    "node": ">=24.15 <25"
  },
  "scripts": {
    "build": "npm run db:generate && npm run api:generate && npm run build --workspace apps/web",
    "typecheck": "npm run typecheck --workspaces && tsc -p load/tsconfig.json",
    "lint": "biome lint .",
    "format:check": "biome format .",
    "format": "biome format --write .",
    "test:unit": "npm run test:unit --workspaces --if-present && npm run test:load:unit",
    "test:integration": "npm run test:integration --workspace apps/api",
    "test:contract": "npm run test:contract --workspace apps/api",
    "test:e2e": "playwright test",
    "db:generate": "npm run db:generate --workspace apps/api",
    "api:generate": "npm run build --workspace apps/api && npm run schema:export --workspace apps/api && npm run api:generate --workspace apps/web",
    "lint:fix": "biome lint --write .",
    "check": "biome check .",
    "test:coverage": "npm run test:coverage --workspace apps/api && npm run test:coverage --workspace apps/web",
    "verify": "npm run build && npm run check && npm run typecheck && npm run test:coverage && npm run test:ci && npm run test:load:unit",
    "test:ci": "node --test scripts/ci-workflow.test.mjs",
    "test:load": "k6 run -e MODE=load load/profile.ts",
    "test:load:smoke": "k6 run -e MODE=smoke load/profile.ts",
    "test:load:stress": "k6 run -e MODE=stress load/profile.ts",
    "test:load:unit": "node --test load/support.test.ts",
    "test:load:integration": "npm run test:load:integration --workspace apps/api",
    "test:load:maximum": "k6 run load/maximum.ts"
  },
  "packageManager": "npm@11.21.1",
  "devDependencies": {
    "@biomejs/biome": "2.6.5",
    "@graphql-codegen/cli": "7.4.6",
    "@graphql-codegen/typescript": "6.1.2",
    "@graphql-codegen/typescript-graphql-request": "7.1.0",
    "@graphql-codegen/typescript-operations": "6.2.0",
    "@nestjs/testing": "12.3.3",
    "@playwright/test": "1.64.1",
    "@testcontainers/postgresql": "12.2.1",
    "@testing-library/jest-dom": "7.0.1",
    "@testing-library/react": "16.3.3",
    "@types/express": "5.0.6",
    "@types/k6": "2.3.1",
    "@types/node": "24.19.2",
    "@types/pg": "8.23.1",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@types/supertest": "7.2.1",
    "@vitejs/plugin-react": "6.2.1",
    "@vitest/coverage-v8": "5.1.0",
    "jsdom": "30.1.3",
    "prisma": "7.10.1",
    "supertest": "7.3.1",
    "testcontainers": "12.2.1",
    "typescript": "6.0.3",
    "vite": "8.3.5",
    "vitest": "5.1.0",
    "yaml": "2.9.1"
  }
}
