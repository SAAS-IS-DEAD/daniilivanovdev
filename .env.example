# Copy to .env; set your own local database password and random AUTH_RATE_KEY.
DATABASE_URL=postgresql://card:REPLACE_ME@localhost:5432/card
POSTGRES_USER=card
POSTGRES_PASSWORD=REPLACE_ME
POSTGRES_DB=card
APP_ORIGIN=http://localhost:3000
NODE_ENV=development
PORT=3000
# Generate a value with: node -e "console.log(require('node:crypto').randomBytes(32).toString('hex'))"
AUTH_RATE_KEY=
CLIENT_IP_MODE=direct
TRUSTED_PROXY_CIDRS=
