# Copy to .env; set your own local database password.
DATABASE_URL=postgresql://card:REPLACE_ME@localhost:5432/card
POSTGRES_USER=card
POSTGRES_PASSWORD=REPLACE_ME
POSTGRES_DB=card
APP_ORIGIN=http://localhost:3000
NODE_ENV=development
PORT=3000

# Optional for a standalone API; Compose sets its internal Redis URL automatically.
REDIS_URL=
# Public read cache; direct database updates become visible within this TTL.
CACHE_TTL_SECONDS=60
